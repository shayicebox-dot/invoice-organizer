# ---------------------------------------------------------------------------
# ICEBOX OS — environment variables
# Copy to `.env.local` (git-ignored) and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# Safe to expose to the browser (anon key is protected by RLS policies).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses Row Level Security.
# Never prefix with NEXT_PUBLIC_. Never import into a client component.
SUPABASE_SERVICE_ROLE_KEY=
