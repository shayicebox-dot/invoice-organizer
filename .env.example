# ---------------------------------------------------------------------------
# ICEBOX OS — environment variables
# Copy to `.env.local` (git-ignored) and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# Safe to expose to the browser (anon key is protected by RLS policies).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses Row Level Security.
# Never prefix with NEXT_PUBLIC_. Never import into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Shopify Admin API — SERVER ONLY
# Created as a custom app in the Shopify admin:
#   Settings → Apps and sales channels → Develop apps
# The access token grants read access to the whole store. Never prefix it
# NEXT_PUBLIC_, never commit a real value.
# ---------------------------------------------------------------------------

# Your permanent Shopify domain, e.g. icebox.myshopify.com (not the custom domain).
SHOPIFY_STORE_DOMAIN=

# Admin API access token, shown once when the app is installed. Starts with shpat_.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Optional. Admin API version to pin, e.g. 2026-07. Defaults to the version in
# src/integrations/shopify/config.ts when unset.
SHOPIFY_API_VERSION=

# ---------------------------------------------------------------------------
# Integration test endpoints
# ---------------------------------------------------------------------------

# Shared secret protecting /api/integrations/*/test until authentication exists.
# Invent a long random string. Unset means those endpoints are disabled.
ICEBOX_INTEGRATION_TEST_SECRET=
