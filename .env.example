# =====================================================================
# Ecom P&L — environment
# =====================================================================
# Copy to `.env.local` and fill in. `.env.local` is git-ignored.
# No credential belongs in source control or in the application database.
#
# The app starts with none of these set and runs on deterministic mock
# data. Shopify is implemented today; everything else below is the target
# configuration for later phases.
# =====================================================================

# --- Application -----------------------------------------------------
# Public base URL. Used to build OAuth redirect URIs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Supabase --------------------------------------------------------
# Project URL and anon key are safe to expose to the browser; they are
# only usable within the bounds of row-level security.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server-only. Bypasses row-level security — used by ingestion jobs.
# Never expose this to the client and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=""

# Direct Postgres connection, for migrations.
DATABASE_URL=""

# --- Shopify (LIVE — implemented) ------------------------------------
# The only integration that is wired up. With all three set, the Overview
# page reads real revenue, discounts, refunds, orders and units from the
# Shopify Admin GraphQL API. Leave any of them blank and the app falls
# back to mock data and reports "Not connected".
#
# These are read on the server only. Do not prefix them with NEXT_PUBLIC_
# — that would ship the secret to the browser.
#
# Required app scope: read_orders
# (read_all_orders as well, if you need orders older than 60 days).

SHOPIFY_STORE_DOMAIN=""       # example.myshopify.com
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""

# Optional. Defaults to the version pinned in src/lib/shopify/config.ts.
SHOPIFY_API_VERSION=""

# --- Meta Ads (LIVE — implemented) -----------------------------------
# With both set, the Overview page reads real Meta Ads spend from the
# Marketing API for the selected date range. Leave either blank and ad
# spend falls back to mock data and is marked MOCK.
#
# Server-only. The token is sent as an Authorization: Bearer header,
# never as an access_token query parameter — a token in a URL ends up in
# proxy and access logs.
#
# Required permission: ads_read
#
# The ad account must bill in the same currency the dashboard reports in.
# If it does not, ad spend stays on mock data and the banner explains why:
# subtracting one currency from another would misstate profit.

META_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID=""        # act_1234567890 or 1234567890

# Optional. Defaults to the version pinned in src/lib/meta/config.ts.
# Set this if Meta reports an unsupported API version.
META_API_VERSION=""

# --- Provider OAuth applications -------------------------------------
# App-level credentials. Per-merchant access tokens are obtained through
# the OAuth flow and stored in the secret manager, keyed by
# `connections.credential_ref` — never in this file and never in a table.

GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_DEVELOPER_TOKEN=""

KLAVIYO_CLIENT_ID=""
KLAVIYO_CLIENT_SECRET=""

OMNISEND_CLIENT_ID=""
OMNISEND_CLIENT_SECRET=""

MAILCHIMP_CLIENT_ID=""
MAILCHIMP_CLIENT_SECRET=""

# --- Secret manager --------------------------------------------------
# Where per-merchant provider tokens are held. `connections.credential_ref`
# is an opaque pointer into this store.
SECRETS_PROVIDER="supabase_vault"
SECRETS_ENCRYPTION_KEY=""

# --- Jobs ------------------------------------------------------------
# Shared secret for the scheduled ingestion endpoint.
SYNC_CRON_SECRET=""
# How many trailing days each sync recomputes, to absorb late refunds
# and restated ad spend.
SYNC_LOOKBACK_DAYS="7"
