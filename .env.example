# ---------------------------------------------------------------------------
# ICEBOX OS — environment variables
# Copy to `.env.local` (git-ignored) and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# Safe to expose to the browser (anon key is protected by RLS policies).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses Row Level Security.
# Never prefix with NEXT_PUBLIC_. Never import into a client component.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Shopify Admin API — SERVER ONLY
#
# Authentication uses the client credentials grant: the app exchanges its
# Client ID and Client secret for an access token that expires after 24 hours.
# The token is fetched, cached and refreshed server-side; there is no permanent
# shpat_ token to store.
#
# Credentials come from the Shopify Dev Dashboard: your app → Settings.
# Never prefix these NEXT_PUBLIC_, never commit a real value. The client secret
# can mint tokens for the whole store — treat it like a password.
# ---------------------------------------------------------------------------

# Your permanent Shopify domain, e.g. iceboxsneakers.myshopify.com (not the custom domain).
SHOPIFY_STORE_DOMAIN=

# App credentials from the Dev Dashboard.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional. Admin API version to pin, e.g. 2026-07. Defaults to the version in
# src/integrations/shopify/config.ts when unset.
SHOPIFY_API_VERSION=

# ---------------------------------------------------------------------------
# Meta Ads (Marketing API) — SERVER ONLY
#
# Authentication is a long-lived System User token from Meta Business Manager:
# Business settings -> Users -> System users -> Generate new token, with the
# ads_read permission and access to the ad account.
#
# Never prefix these NEXT_PUBLIC_, never commit a real value. The token can
# read the whole ad account's spend and performance.
# ---------------------------------------------------------------------------

# Ad account id from Ads Manager. With or without the act_ prefix.
META_AD_ACCOUNT_ID=

# System user access token.
META_ACCESS_TOKEN=

# Optional. Graph API version to pin, e.g. v23.0. Defaults to the version in
# src/integrations/meta/config.ts when unset.
META_API_VERSION=

# The database also stores the product mapping — how many physical boxes each
# Shopify variant contains, which every cost figure is multiplied by. Without
# it the app still runs, but Settings cannot save a mapping. Apply
# supabase/migrations/0001_product_box_mapping.sql once before first use.

# ---------------------------------------------------------------------------
# Login — SERVER ONLY
# ---------------------------------------------------------------------------

# The single owner password for ICEBOX OS. Also signs the session cookie, so
# changing it signs everyone out immediately. Use a long, random passphrase.
# Unset means nobody can get in — the app fails closed rather than open.
ICEBOX_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Integration test endpoints
# ---------------------------------------------------------------------------

# Shared secret protecting /api/integrations/*/test until authentication exists.
# Invent a long random string. Unset means those endpoints are disabled.
ICEBOX_INTEGRATION_TEST_SECRET=
