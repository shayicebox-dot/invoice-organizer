{
  "name": "ecom-pl",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "smoke:google-ads": "tsx --conditions=react-server scripts/smoke-google-ads.mts",
    "test": "node --import tsx --conditions=react-server --test \"tests/*.test.mts\"",
    "verify:cogs": "tsx --conditions=react-server scripts/verify-cogs.mts"
  },
  "dependencies": {
    "google-auth-library": "^11.0.2",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "description": "One truthful daily P&L dashboard for ecommerce."
}
