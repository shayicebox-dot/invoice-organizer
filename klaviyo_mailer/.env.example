# Copy to .env and fill in. Load it before running, e.g.:
#   set -a; source klaviyo_mailer/.env; set +a

# Required
ANTHROPIC_API_KEY=sk-ant-...
KLAVIYO_API_KEY=pk_...

# Brand / content defaults
BRAND_NAME=kickbox
PRODUCT_NAME=kickbox
EMAIL_LANGUAGE=he

# Campaign sender (required to create campaigns) — must be a verified sender in Klaviyo
FROM_EMAIL=hello@yourdomain.com
FROM_LABEL=kickbox

# Default audience (use either the list id or the list name)
KLAVIYO_LIST_ID=
KLAVIYO_LIST_NAME=

# Default call-to-action link
CTA_URL=https://yourstore.example/kickbox
