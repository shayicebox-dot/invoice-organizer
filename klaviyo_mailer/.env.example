# Copy to .env and fill in. Load it before running, e.g.:
#   set -a; source klaviyo_mailer/.env; set +a

# Required
ANTHROPIC_API_KEY=sk-ant-...
KLAVIYO_API_KEY=pk_...

# Brand / content defaults (Kicksbox — kicksboxx.com)
BRAND_NAME=Kicksbox
PRODUCT_NAME=clear stackable magnetic sneaker display boxes
EMAIL_LANGUAGE=en
# Optional: override the built-in brand brief fed to the AI (see config.py)
# BRAND_BRIEF=

# Campaign sender (required to create campaigns) — must be a verified sender in Klaviyo
FROM_EMAIL=hello@kicksboxx.com
FROM_LABEL=Kicksbox

# Default audience (use either the list id or the list name)
KLAVIYO_LIST_ID=
KLAVIYO_LIST_NAME=

# Default call-to-action link
CTA_URL=https://kicksboxx.com/collections/shoebox
