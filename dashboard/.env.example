# ─────────────────────────────────────────────────────────────
# Supabase (database + auth)
# Get these from: https://app.supabase.com → Project → Settings → API
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ─────────────────────────────────────────────────────────────
# Anthropic Claude (AI insights)
# Get from: https://console.anthropic.com
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─────────────────────────────────────────────────────────────
# Shopify – one block per store. Comma-separated lists are read at runtime.
# Create a custom app per store, enable Admin API scopes:
#   read_orders, read_products, read_inventory, read_customers, read_fulfillments
# ─────────────────────────────────────────────────────────────
SHOPIFY_STORES=kicksbox,icebox,bruno

SHOPIFY_KICKSBOX_DOMAIN=kicksbox.myshopify.com
SHOPIFY_KICKSBOX_TOKEN=shpat_xxx
SHOPIFY_KICKSBOX_CURRENCY=USD

SHOPIFY_ICEBOX_DOMAIN=icebox.myshopify.com
SHOPIFY_ICEBOX_TOKEN=shpat_xxx
SHOPIFY_ICEBOX_CURRENCY=ILS

SHOPIFY_BRUNO_DOMAIN=bruno.myshopify.com
SHOPIFY_BRUNO_TOKEN=shpat_xxx
SHOPIFY_BRUNO_CURRENCY=USD

# ─────────────────────────────────────────────────────────────
# Meta (Facebook) Ads
# https://developers.facebook.com/apps → Marketing API → System User Token
# ─────────────────────────────────────────────────────────────
META_ACCESS_TOKEN=EAAB...
META_AD_ACCOUNTS=act_111111,act_222222

# ─────────────────────────────────────────────────────────────
# Google Ads (developer token + OAuth refresh token)
# https://developers.google.com/google-ads/api/docs/oauth/cloud-project
# ─────────────────────────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_IDS=

# ─────────────────────────────────────────────────────────────
# Klaviyo (per brand if separate accounts)
# https://www.klaviyo.com/account#api-keys-tab  – Private API key
# ─────────────────────────────────────────────────────────────
KLAVIYO_KICKSBOX_API_KEY=pk_xxx
KLAVIYO_ICEBOX_API_KEY=pk_xxx
KLAVIYO_BRUNO_API_KEY=pk_xxx

# ─────────────────────────────────────────────────────────────
# FX (currency conversion). Free key from https://exchangerate.host
# ─────────────────────────────────────────────────────────────
FX_BASE_CURRENCY=USD
FX_API_KEY=

# ─────────────────────────────────────────────────────────────
# Cron protection – any random string. Vercel calls /api/sync with this header.
# ─────────────────────────────────────────────────────────────
CRON_SECRET=change-me-to-a-long-random-string
